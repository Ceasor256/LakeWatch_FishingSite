# Copy this file to `.env` and change the values.
# Every setting is optional for local practice: with no .env at all the app runs
# in debug mode on a local SQLite database (db.sqlite3).

# --- Django ---------------------------------------------------------------
# Generate a strong key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
# Must be False on any server other people can reach.
DJANGO_DEBUG=True
# Comma-separated host names this site is served from.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Needed when served over HTTPS on a real domain, e.g. https://lakewatch.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Kampala

# --- PostgreSQL (optional) -----------------------------------------------
# Remove the leading "# " from these lines to switch from SQLite to PostgreSQL.
# DB_NAME=fish_landing_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_HOST=127.0.0.1
# DB_PORT=5432
